# Neon Postgres connection string
DATABASE_URL=

# 32 random bytes, base64. Encrypts the Tesla refresh token at rest.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Long random string. Needed to start the Tesla sign-in (/api/auth/tesla/login?key=...).
ADMIN_SECRET=

# Tesla developer app
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://tesla.skylerfly.com/api/auth/tesla/callback
# North America. Europe: https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
# Domain that hosts the public key (no https://). Used by the register script.
TESLA_PARTNER_DOMAIN=tesla.skylerfly.com

# PEM text of the app PUBLIC key (prime256v1). Never put the private key here.
TESLA_PUBLIC_KEY=
